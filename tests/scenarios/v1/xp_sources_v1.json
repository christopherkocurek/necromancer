{
	"schema_version": "v1",
	"id": "xp_sources_v1",
	"name": "XP source accounting (live)",
	"mode": "deterministic",
	"seed": 105,
	"severity": "major",
	"tags": ["xp", "progression", "live"],
	"setup": [
		{"op": "boot_game", "args": {"name": "XP Harness"}},
		{"op": "gain_xp", "args": {"source": "kill", "raw_amount": 12, "event_context": "elite_bonus"}}
	],
	"actions": [],
	"settle_ticks": 1,
	"checkpoints": [
		{
			"id": "cp_xp_ledger",
