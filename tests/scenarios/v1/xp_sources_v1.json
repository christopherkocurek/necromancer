				{"type": "eq", "path": "xp_state.source", "value": "kill", "severity": "minor"},
				{"type": "eq", "path": "xp_state.raw_amount", "value": 12, "severity": "minor"},
				{"type": "eq", "path": "xp_state.final_amount", "value": 15, "severity": "major"},
				{"type": "contains", "path": "xp_state.event_context", "value": "bonus", "severity": "minor"}
			],
			"visual_severity": "minor"
		}
	],
	"teardown": [{"op": "teardown_game"}]
}
